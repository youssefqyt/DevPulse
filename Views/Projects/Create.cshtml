@model DevPulse.Models.Project

@{
    ViewData["Title"] = "Create Project";
}

<div class="page-shell">

    <div class="panel" style="max-width: 800px; margin: 0 auto;">

        <span class="eyebrow">NEW WORKSPACE</span>
        <h2 style="margin-top: 5px; margin-bottom: 25px;">Create Project</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 20px;"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Name">Project Name *</label>
                    <input asp-for="Name" placeholder="e.g. Cloud Sync Engine" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Technology">Technology Stack *</label>
                    <input asp-for="Technology"
                           placeholder="e.g. ASP.NET Core, PostgreSQL, React" required />
                    <span asp-validation-for="Technology" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description"
                              rows="4"
                              placeholder="Describe the goals, architecture, and deliverable features..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status">
                        <option value="Active">Active</option>
                        <option value="Completed">Completed</option>
                        <option value="Paused">Paused</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Priority">Priority</label>
                    <select asp-for="Priority">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Progress">Initial Progress %</label>
                    <input asp-for="Progress"
                           type="number"
                           min="0"
                           max="100" />
                    <span asp-validation-for="Progress" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EstimatedHours">Estimated Hours</label>
                    <input asp-for="EstimatedHours"
                           type="number"
                           step="0.5"
                           min="0"
                           placeholder="40.0" />
                    <span asp-validation-for="EstimatedHours" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HoursSpent">Hours Spent</label>
                    <input asp-for="HoursSpent"
                           type="number"
                           step="0.5"
                           min="0"
                           placeholder="0.0" />
                    <span asp-validation-for="HoursSpent" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StartDate">Start Date</label>
                    <input asp-for="StartDate"
                           type="date" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DueDate">Due Date</label>
                    <input asp-for="DueDate"
                           type="date" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions" style="margin-top: 30px;">
                <button type="submit" class="primary-button">
                    Create Project
                </button>

                <a asp-action="Index" class="secondary-button">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
